# ── LLM Provider API Keys ────────────────────────────────────────────────────
CTA_OPENAI_API_KEY=your_openai_api_key_here
CTA_GROQ_API_KEY=your_groq_api_key_here
CTA_GEMINI_API_KEY=your_gemini_api_key_here
CTA_XAI_API_KEY=your_xai_api_key_here

# ── Application Settings ─────────────────────────────────────────────────────
CTA_DEFAULT_LLM_PROVIDER=openai
CTA_LOG_LEVEL=INFO

# ── Scoring Thresholds ───────────────────────────────────────────────────────
CTA_COUNTRY_SCORE_THRESHOLD=0.5
CTA_SITE_SCORE_THRESHOLD=0.4
CTA_RISK_SCORE_THRESHOLD=0.7
CTA_FEASIBILITY_SCORE_THRESHOLD=0.6

# ── Retry Limits ─────────────────────────────────────────────────────────────
CTA_MAX_ENRICHMENT_RETRIES=2
CTA_MAX_COMPLIANCE_RETRIES=1
CTA_MAX_SITE_RESELECTION_RETRIES=1

# ── PostgreSQL ───────────────────────────────────────────────────────────────
CTA_DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/database_name
CTA_DATABASE_URL_SYNC=postgresql://username:password@localhost:5432/database_name

# ── RAG / Vector DB ──────────────────────────────────────────────────────────
CTA_RAG_PROVIDER=chroma
CTA_CHROMA_PERSIST_DIRECTORY=./chroma_data

# ── Embedding ────────────────────────────────────────────────────────────────
CTA_EMBEDDING_PROVIDER=sentence_transformers
CTA_EMBEDDING_MODEL=all-MiniLM-L6-v2